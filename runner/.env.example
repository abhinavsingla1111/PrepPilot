RUNNER_API_URL=http://127.0.0.1:8080
RUNNER_WORKER_TOKEN=replace-with-the-same-long-random-runner-token-as-the-api
RUNNER_POLL_SECONDS=2
RUNNER_REQUEST_TIMEOUT_SECONDS=10
RUNNER_CONTAINER_TIMEOUT_SECONDS=30
RUNNER_COMPILE_TIMEOUT_SECONDS=10
RUNNER_TEST_TIMEOUT_SECONDS=2
RUNNER_MAX_OUTPUT_BYTES=32768
RUNNER_MEMORY_LIMIT=512m
RUNNER_CPU_LIMIT=1.0
RUNNER_PIDS_LIMIT=64
RUNNER_IMAGE_JAVA=localhost/preppilot-runner-java:21
RUNNER_IMAGE_CPP=localhost/preppilot-runner-cpp:14
RUNNER_IMAGE_PYTHON=localhost/preppilot-runner-python:3.13
