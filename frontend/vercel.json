{
  "$schema": "https://openapi-vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://preppilot-api-p54e.onrender.com/api/$1"
    },
    {
      "source": "/actuator/(.*)",
      "destination": "https://preppilot-api-p54e.onrender.com/actuator/$1"
    }
  ]
}
