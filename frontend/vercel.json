{
  "$schema": "https://openapi-vercel.sh/vercel.ison",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-RENDER-HOST.onrender.com/api/path**"
    },
    {
      "source": "/actuator/:path**",
      "destination": "https://REPLACE-WITH-RENDER-HOST.onrender.com/actuator/path*"
    }
  ]
}
