# =============================================================================
# PrepPilot environment template
# =============================================================================
# Copy this file to .env and replace every placeholder before running PrepPilot.
# Values are read by docker-compose.yml and Spring Boot.

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
# Database and role created by the PostgreSQL container.
POSTGRES_DB=preppilot
POSTGRES_USER=preppilot
# Secret for the PostgreSQL role. Generate a long random value.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# JDBC connection used by Spring Boot. localhost is correct when the API runs
# directly; docker-compose overrides the host to the postgres service.
DATABASE_URL=jdbc:postgresql://localhost:5432/preppilot
DATABASE_USERNAME=preppilot
# Must match POSTGRES_PASSWORD for the standard local Compose setup.
DATABASE_PASSWORD=replace-with-the-same-postgres-password

# ----------------------------------------------------------------------------
# Authentication and browser session
# ----------------------------------------------------------------------------
# Secret pepper used to hash opaque session tokens and rate-limit identifiers.
# Generate with: openssl rand -hex 32
# Changing it invalidates existing sessions. Never expose or commit it.
AUTH_TOKEN_PEPPER=replace-with-a-long-random-secret

# false for plain HTTP localhost; true for every HTTPS deployment.
AUTH_COOKIE_SECURE=false
# Strict provides the strongest same-site protection. Use Lax only when an
# intentional cross-site navigation flow requires it.
AUTH_COOKIE_SAME_SITE=Strict
# Development only. When true, OTPs appear in the UI and local API logs.
# Production must always use false.
EXPOSE_DEV_OTP=false

# ----------------------------------------------------------------------------
# Public URLs, CORS, and trusted proxy handling
# ----------------------------------------------------------------------------
# Exact browser origins allowed to call the API. Separate multiple origins
# with commas; do not use * with credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173
# Public same-origin URL used in links placed in notification emails.
APP_PUBLIC_URL=http://localhost:8081
# NONE is safest for direct/local access. Set FRAMEWORK only when every public
# request passes through a trusted reverse proxy such as Caddy or Nginx.
FORWARD_HEADERS_STRATEGY=NONE

# ----------------------------------------------------------------------------
# OTP request throttling
# ----------------------------------------------------------------------------
# Minimum wait before requesting another code for the same email address.
OTP_RESEND_COOLDOWN=60s
# Rolling per-email window and maximum requests allowed within that window.
OTP_EMAIL_WINDOW=15m
OTP_MAX_REQUESTS_PER_EMAIL=5
# Rolling per-client-IP window and maximum requests allowed within it.
# Client IPs are keyed-hashed before being stored.
OTP_IP_WINDOW=15m
OTP_MAX_REQUESTS_PER_IP=20

# ----------------------------------------------------------------------------
# Transactional email
# ----------------------------------------------------------------------------
# false uses the development logging adapter; true enables real delivery.
MAIL_ENABLED=false
# smtp = existing SMTP adapter; resend = production HTTPS email adapter.
MAIL_PROVIDER=smtp
# Required only when MAIL_PROVIDER=resend. Create a restricted sending key and
# store the real value only in .env or the deployment platform's secret store.
RESEND_API_KEY=

# SMTP-only settings. Ignored when MAIL_PROVIDER=resend.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Sender identity for every provider. With Resend, its domain/subdomain must be
# verified and have the provider's SPF and DKIM records.
MAIL_FROM=PrepPilot <no-reply@example.com>
# Inbox that receives issue reports and improvement suggestions.
# Required for Resend; SMTP falls back to MAIL_USERNAME when left empty.
FEEDBACK_RECIPIENT_EMAIL=

# ----------------------------------------------------------------------------
# Self-hosted Interview Lab runner
# ----------------------------------------------------------------------------
# Enables the API-side durable execution queue. The worker still runs as a
# separate process/VM and must use the same RUNNER_WORKER_TOKEN.
RUNNER_ENABLED=false
# Dedicated worker credential. Generate with: openssl rand -base64 48
# Never reuse AUTH_TOKEN_PEPPER or a database password.
RUNNER_WORKER_TOKEN=replace-with-a-different-long-random-secret
# Maximum code-run requests per authenticated user in a rolling day.
RUNNER_DAILY_LIMIT=5
# Minimum delay between runs by the same user.
RUNNER_MINIMUM_INTERVAL=3s
# Time a worker owns a job before an abandoned claim can be recovered.
RUNNER_LEASE_DURATION=60s
# Maximum processing attempts before a queued job is marked failed.
RUNNER_MAX_ATTEMPTS=3
# Sends an email after asynchronous execution when email delivery is enabled.
RUNNER_EMAIL_RESULTS=false

# ----------------------------------------------------------------------------
# Frontend appearance (embedded by Vite at build time)
# ----------------------------------------------------------------------------
# ocean = current blue-first palette; lime = legacy green-first palette.
VITE_UI_THEME=ocean
# Light/dark reveal duration in milliseconds. 0 disables it; maximum is 5000.
VITE_THEME_TRANSITION_MS=700
